{
  "name": "civicfix-workspace",
  "version": "1.0.0",
  "description": "CivicFix – Public Infrastructure Complaint & Repair Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,teal\" \"npm run server\" \"npm run client\"",
    "start": "npm run dev",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "db:start": "node scripts/start-mongo.js",
    "generate:pdf": "node scripts/generate_pdf.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
